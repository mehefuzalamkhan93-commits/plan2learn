# =============================================================================
# Plan2Learn — Backend Environment Configuration Example

# Copy this file to `.env` (which is gitignored) and fill in your real credentials.
# =============================================================================

# Application Environment: 'development' | 'production' | 'test'
APP_ENV=development

# JWT Secret Key for user authentication (REQUIRED in production)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt

# CORS allowed frontend origins (JSON array format, e.g. ["http://localhost:3000", "https://your-app.vercel.app"])
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# Database Configuration (SQLite for local dev, Turso libSQL for production)
# -----------------------------------------------------------------------------
# Selection mechanism:
# - Leave TURSO_DATABASE_URL empty for local development (uses smart_planner.db)
# - Set TURSO_DATABASE_URL & TURSO_AUTH_TOKEN for production deployment (Render)
# - To force local SQLite even if Turso vars are defined, set DATABASE_BACKEND=sqlite
DATABASE_BACKEND=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# AI Providers Configuration
# -----------------------------------------------------------------------------
AI_PROVIDER_MODE=auto
AI_PRIMARY_PROVIDER=omniroute
AI_FALLBACK_PROVIDER=groq
AI_PRIMARY_MODEL=
AI_FALLBACK_MODEL=openai/gpt-oss-120b
AI_TASK_MODELS={}

OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_MODEL=auto/best-fast
OMNIROUTE_TIMEOUT_SECONDS=120

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# YouTube Transcript & Data API v3
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=your-google-youtube-api-key

# -----------------------------------------------------------------------------
# Google Drive OAuth 2.0 Integration (Optional)
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret-placeholder
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/api/v1/ai/drive/callback
GOOGLE_DRIVE_API_KEY=your-browser-api-key-placeholder
GOOGLE_DRIVE_APP_ID=your-oauth-project-number-placeholder
FRONTEND_BASE_URL=http://localhost:3000
